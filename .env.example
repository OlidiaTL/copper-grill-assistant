# Copy to .env and fill in. Never commit .env.

# Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Which Claude model answers guests. Sonnet is a good balance of quality and cost.
CLAUDE_MODEL=claude-sonnet-5-5
# Most Claude requests per day for the whole assistant (one guest message uses 1 to 8). After that, guests are
# asked to call the restaurant until midnight. 0 = no ceiling. Also set a spending limit in the Anthropic Console.
CLAUDE_DAILY_CALL_LIMIT=3000

# The Copper Grill site and its assistant key (ASSISTANT_API_KEY in that site's .env.local)
# Must be https:// on a server; http:// is only accepted for localhost.
GRILL_URL=http://localhost:3000
GRILL_API_KEY=

# Port for this assistant
PORT=4000
# Who can connect. 127.0.0.1 = only this machine (safe default). On a server that receives
# WhatsApp webhooks, set HOST=0.0.0.0.
HOST=127.0.0.1
# The test chat page (http://localhost:4000). It accepts any typed number, so it is OFF unless
# this is 1, and even then it only answers this machine. Never set it on a live server.
TEST_CHAT=

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup).
# Leave empty until the restaurant has its WhatsApp Business number.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# A random string (e.g. from `openssl rand -hex 16`); enter the same one when Meta asks for the webhook's verify token.
WHATSAPP_VERIFY_TOKEN=
# Meta for Developers > your app > App settings > Basic > App secret. Proves each incoming
# message really came from Meta; without it the webhook refuses every message.
WHATSAPP_APP_SECRET=
# The approved message template used for day-of reminders (see README).
WHATSAPP_REMINDER_TEMPLATE=booking_reminder
WHATSAPP_GRAPH_VERSION=v23.0

# The restaurant's privacy page, linked in the first reply of each conversation. Leave empty until there is one.
PRIVACY_URL=
# Days to keep the accuracy log (logs/turns-<date>.jsonl). 0 = don't keep a log.
LOG_KEEP_DAYS=30
