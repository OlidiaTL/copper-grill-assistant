# Copy to .env and fill in. Never commit .env.

# Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Which Claude model answers guests. Sonnet is a good balance of quality and cost.
CLAUDE_MODEL=claude-sonnet-5-5

# The Copper Grill site and its assistant key (ASSISTANT_API_KEY in that site's .env.local)
GRILL_URL=http://localhost:3000
GRILL_API_KEY=

# Port for this assistant (the test chat page is at http://localhost:4000)
PORT=4000

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup).
# Leave empty until the restaurant has its WhatsApp Business number.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret word you choose; enter the same one when Meta asks for the webhook's verify token.
WHATSAPP_VERIFY_TOKEN=
# The approved message template used for day-of reminders (see README).
WHATSAPP_REMINDER_TEMPLATE=booking_reminder
WHATSAPP_GRAPH_VERSION=v23.0
