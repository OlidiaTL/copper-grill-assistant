{
  "name": "copper-grill-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp booking assistant for The Copper Grill, powered by Claude",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "reminders": "tsx --env-file=.env src/reminders.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
